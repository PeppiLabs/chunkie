# Chunkie's public live site, served by Caddy inside the Railway container.
# Only the built files in /srv are served. The password gate is a Vite plugin
# and never runs here. Railway terminates TLS and sets PORT.
{
	auto_https off
	admin off
}

# Errors (a 404 for a missing file, a 405 for a POST) are written outside the
# normal handler chain, so the headers are imported there too.
(security_headers) {
	header {
		# Cross origin isolation lets the embedding model use its faster
		# multi threaded runtime. Same values the dev and preview servers send.
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Embedder-Policy require-corp
		# HTTPS only. No includeSubDomains, so other peppilabs.net sites are untouched.
		Strict-Transport-Security max-age=31536000
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Scripts, workers and styles only from this site. Network requests only
		# to this site and to Hugging Face, which hosts the model.
		# 'wasm-unsafe-eval' lets the WASM runtime compile; it does not allow
		# eval() of JavaScript.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://huggingface.co https://*.huggingface.co https://*.hf.co; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
		-Server
	}
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	# Railway's health check.
	respond /healthz "ok" 200

	# /app without the slash is what people type.
	redir /app /app/ permanent

	# The build manifest is only read by the staging password gate. The
	# Dockerfile deletes it; this is the second lock.
	@hidden path /.vite/*
	respond @hidden 404

	import security_headers

	# File names in /assets carry a content hash, so they never change.
	@assets path /assets/*
	header @assets {
		Cache-Control "public, max-age=31536000, immutable"
		# Deferred, so a 404 for a missing asset is not cached for a year.
		defer
	}

	# Pages are always revalidated, so a deploy shows up at once.
	@pages path / /index.html /app/ /app/index.html /concepts.html /concepts.js
	header @pages Cache-Control no-cache

	file_server {
		# Serve the .gz siblings made at build time; encode handles the rest.
		precompressed gzip
	}

	handle_errors {
		import security_headers
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}
