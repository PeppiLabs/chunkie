{
  "name": "chunkie",
  "version": "1.0.0",
  "private": false,
  "description": "An open source, browser based visualizer that shows how retrieval augmented generation works, from chunking to embeddings to semantic search.",
  "license": "MIT",
  "author": "Peppi Labs",
  "homepage": "https://github.com/PeppiLabs/chunkie",
  "repository": {
    "type": "git",
    "url": "https://github.com/PeppiLabs/chunkie.git"
  },
  "bugs": {
    "url": "https://github.com/PeppiLabs/chunkie/issues"
  },
  "keywords": [
    "rag",
    "retrieval-augmented-generation",
    "embeddings",
    "vector-search",
    "semantic-search",
    "transformers-js",
    "education",
    "visualization"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:exe": "node scripts/build-exe.js",
    "preview": "vite preview",
    "start": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "password": "node scripts/generate-password.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@huggingface/transformers": "^4.2.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.12.3",
    "onnxruntime-web": "1.26.0-dev.20260416-b7804b056c",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.5.0",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "yaml": "^2.9.1"
  }
}
