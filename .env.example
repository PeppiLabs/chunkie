# Where the frontend finds the backend. Defaults to http://localhost:5050.
# VITE_API_URL=http://localhost:5050

# Port the backend listens on. Defaults to 5050.
# PORT=5050

# Interface the backend binds to. Defaults to 127.0.0.1, this machine only.
# Only change this if you understand that the server serves its data folder
# to anyone who can reach it.
# HOST=127.0.0.1

# Extra browser origins allowed to call the backend, comma separated.
# Any port on http://localhost and http://127.0.0.1 is always allowed.
# ALLOWED_ORIGINS=http://192.168.1.20:5173
